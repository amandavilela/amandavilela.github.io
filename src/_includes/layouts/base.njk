<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{{ title }}{% if page.url != '/' %} | Amanda Vilela | Frontend Specialist{% endif %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" href="/favicon.ico" />

        <link rel="preload" href="/fonts/merriweather-900italic.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/inconsolata-regular.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/inconsolata-600.woff2" as="font" type="font/woff2" crossorigin />

        <style>
            {{ "dist/critical.css" | read_file | cssmin | safe }}
            {% if critical_css %}{{ ("dist/" + critical_css + ".css") | read_file | cssmin | safe }}{% endif %}
            {{ "dist/header.css" | read_file | cssmin | safe }}
        </style>

        {% if page_css %}
            <link rel="stylesheet" href="/{{ page_css }}.css" media="print" onload="this.media='all'" />
            <noscript><link rel="stylesheet" href="/{{ page_css }}.css" /></noscript>
        {% endif %}

        <meta name="description" content="{{ description }}" />
        {% if keywords %}
            <meta name="keywords" content="{{ keywords }}" />
        {% endif %}

        <meta name="author" content="Amanda Vilela">

        <meta property="og:type" content="{% if '/blog/' in page.url and page.url != '/blog/' %}article{% else %}website{% endif %}" />
        <meta property="og:title" content="{{ title }}" />
        <meta property="og:url" content="https://amandavilela.me{{ page.url }}" />
        {% if open_graph %}
            <meta property="og:image" content="https://amandavilela.me/{{ open_graph.image }}" />
        {% endif %}

        <link rel="canonical" href="https://amandavilela.me{{ page.url }}" />

        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@graph": [
                {% if page.url == '/' %}
                {
                    "@type": "WebSite",
                    "@id": "https://amandavilela.me/#website",
                    "url": "https://amandavilela.me/",
                    "name": "Amanda Vilela",
                    "publisher": {
                        "@id": "https://amandavilela.me/#person"
                    }
                },
                {
                    "@type": "Person",
                    "@id": "https://amandavilela.me/#person",
                    "name": "Amanda Vilela",
                    "url": "https://amandavilela.me/",
                    "jobTitle": "Frontend Specialist",
                    "sameAs": [
                        "https://br.linkedin.com/in/amanda-vilela",
                        "https://github.com/amandavilela",
                        "http://codepen.io/amandavilela/",
                        "https://speakerdeck.com/amandavilela",
                        "https://medium.com/@amandavilela"
                    ],
                    "image": "https://amandavilela.me/imgs/layout/profile.webp"
                }
                {% elif page.url != '/404.html' %}
                {
                    "@type": "BreadcrumbList",
                    "itemListElement": [
                        {
                            "@type": "ListItem",
                            "position": 1,
                            "name": "Home",
                            "item": "https://amandavilela.me/"
                        }
                        {% if '/blog/' in page.url %}
                            {% if page.url == '/blog/' %}
                            ,{
                                "@type": "ListItem",
                                "position": 2,
                                "name": "{{ title | breadcrumbTitle }}",
                                "item": "https://amandavilela.me/blog/"
                            }
                            {% else %}
                            ,{
                                "@type": "ListItem",
                                "position": 2,
                                "name": "Blog",
                                "item": "https://amandavilela.me/blog/"
                            },
                            {
                                "@type": "ListItem",
                                "position": 3,
                                "name": "{{ title | breadcrumbTitle }}",
                                "item": "https://amandavilela.me{{ page.url }}"
                            }
                            {% endif %}
                        {% elif '/tags/' in page.url %}
                            ,{
                                "@type": "ListItem",
                                "position": 2,
                                "name": "Blog",
                                "item": "https://amandavilela.me/blog/"
                            },
                            {
                                "@type": "ListItem",
                                "position": 3,
                                "name": "{{ tag }}",
                                "item": "https://amandavilela.me{{ page.url }}"
                            }
                        {% elif '/services/' in page.url %}
                            ,{
                                "@type": "ListItem",
                                "position": 2,
                                "name": "{{ title | breadcrumbTitle }}",
                                "item": "https://amandavilela.me/services/"
                            }
                        {% endif %}
                    ]
                }
                {% endif %}
            ]
        }
        </script>

        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <link rel="dns-prefetch" href="https://www.google-analytics.com" />

        <!-- Google tag (gtag.js) -->
        <script>
            if (window.location.hostname !== 'localhost') {
                const script = document.createElement('script');
                script.src = 'https://www.googletagmanager.com/gtag/js?id=G-GSM2PDRLRD';
                script.async = true;
                script.onload = () => {
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    gtag('js', new Date());

                    gtag('config', 'G-GSM2PDRLRD');
                };

                document.head.appendChild(script);
            }
        </script>

        <script type="speculationrules">
        {
            "prerender": [{
                "where": { "href_matches": "/blog/*" },
                "eagerness": "moderate"
            }]
        }
        </script>
    </head>
    <body>
        <a class="skip-link u-focus-ring" href="#main-content">Skip to main content</a>

            <header class="header">
                <div class="container container--flex">
                    <a class="logo u-focus-ring" href="/">Amanda Vilela</a>
                    <nav aria-label="Main">
                        <ul class="nav">
                            <li><a class="link u-slide-hover u-focus-ring" href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>Home</a></li>
                            <li><a class="link u-slide-hover u-focus-ring" href="/services/"{% if page.url == '/services/' %} aria-current="page"{% endif %}>Services</a></li>
                            <li><a class="link u-slide-hover u-focus-ring" href="/blog/"{% if page.url == '/blog/' %} aria-current="page"{% endif %}>Blog</a></li>
                        </ul>
                    </nav>
                </div>
            </header>

        {% if page.url != '/' and page.url != '/404.html' %}
            <nav aria-label="Breadcrumb" class="breadcrumbs">
                <div class="container">
                    <ol class="list">
                        <li class="item">
                            <a href="/" class="link u-focus-ring">Home</a>
                        </li>
                        {% if '/blog/' in page.url %}
                            {% if page.url == '/blog/' %}
                                <li class="item" aria-current="page">{{ title | breadcrumbTitle }}</li>
                            {% else %}
                                <li class="item">
                                    <a href="/blog/" class="link u-focus-ring">Blog</a>
                                </li>
                                <li class="item" aria-current="page">{{ title | breadcrumbTitle }}</li>
                            {% endif %}
                        {% elif '/tags/' in page.url %}
                            <li class="item">
                                <a href="/blog/" class="link u-focus-ring">Blog</a>
                            </li>
                            <li class="item" aria-current="page">{{ tag }}</li>
                        {% elif '/services/' in page.url %}
                             <li class="item" aria-current="page">{{ title | breadcrumbTitle }}</li>
                        {% endif %}
                    </ol>
                </div>
            </nav>
        {% endif %}

        {{ content | safe }}

        <footer>
            <div class="footer" id="find-me">
                <div class="container">
                    <h2 class="title">Find me online</h2>
                    <ul class="social" role="list">
                        <li>
                            <a class="link u-slide-hover" href="https://br.linkedin.com/in/amanda-vilela" target="_blank" rel="noopener noreferrer"
                                >LinkedIn<span class="u-visually-hidden"> (opens in a new tab)</span></a
                            >
                        </li>
                        <li>
                            <a class="link u-slide-hover" href="https://github.com/amandavilela" target="_blank" rel="noopener noreferrer"
                                >GitHub<span class="u-visually-hidden"> (opens in a new tab)</span></a
                            >
                        </li>
                        <li>
                            <a class="link u-slide-hover" href="http://codepen.io/amandavilela/" target="_blank" rel="noopener noreferrer"
                                >Codepen<span class="u-visually-hidden"> (opens in a new tab)</span></a
                            >
                        </li>
                        <li>
                            <a class="link u-slide-hover" href="https://speakerdeck.com/amandavilela" target="_blank" rel="noopener noreferrer"
                                >Speakerdeck<span class="u-visually-hidden"> (opens in a new tab)</span></a
                            >
                        </li>
                        <li>
                            <a class="link u-slide-hover" href="https://medium.com/@amandavilela" target="_blank" rel="noopener noreferrer"
                                >Medium<span class="u-visually-hidden"> (opens in a new tab)</span></a
                            >
                        </li>
                    </ul>
                </div>
            </div>
            <p class="footer-credit">designed and coded by Amanda Vilela</p>
        </footer>
    </body>
</html>
